    },
    {
      "name": "Trivia - Android",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "android"
    },
    {
      "name": "Trivia - iOS",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "ios"
    },
    {
      "name": "Trivia - Android (release)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
